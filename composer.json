{
    "name": "zeevx/laravel-bachs",
    "description": "Laravel integration for the Bachs API.",
    "type": "library",
    "keywords": [
        "bachs",
        "billing",
        "checkout",
        "laravel",
        "payments",
        "subscriptions"
    ],
    "homepage": "https://github.com/zeevx/laravel-bachs",
    "license": "MIT",
    "authors": [
        {
            "name": "Zeevx",
            "email": "adamsohiani@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Zeevx\\LaravelBachs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeevx\\LaravelBachs\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "zeevx/php-bachs": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zeevx\\LaravelBachs\\BachsServiceProvider"
            ],
            "aliases": {
                "Bachs": "Zeevx\\LaravelBachs\\Facades\\Bachs"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "format": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
